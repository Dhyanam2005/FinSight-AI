# ─── LLM Provider Keys ───────────────────────────────────────────────────────
# Set the key for whichever provider you select in gemini_service.py (PROVIDER=)

# Cerebras (default provider — get a free key at console.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Groq (alternative — get a free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (alternative — get a key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL of your frontend. Used by FastAPI CORS middleware.
# Default: http://localhost:3000 (Next.js dev server)
FRONTEND_URL=http://localhost:3000
